# Job Hunter — environment template
#
# Only secrets and per-deployment overrides go here. Project-wide
# constants (cron schedules, JWT lifetimes, freshness windows, SMTP
# host, third-party API hosts, etc.) are in src/config/constants.ts.
# If you find yourself wanting to add a non-secret default here, add it
# there instead.

# ── Server ─────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ── MongoDB ────────────────────────────────────────────────
# MONGODB_URI is the test/dev cluster — used whenever NODE_ENV is not
# 'production' (local dev, CI, staging). MONGODB_URI_PROD is the
# production cluster — used only when NODE_ENV=production. If
# MONGODB_URI_PROD is unset in production, the loader falls back to
# MONGODB_URI so existing deployments keep working.
MONGODB_URI=mongodb://localhost:27017/job_hunter_test
MONGODB_URI_PROD=

# ── Redis ──────────────────────────────────────────────────
# Local: REDIS_HOST=localhost  REDIS_PORT=6379  (no creds)
# Redis Cloud / Upstash: full host, port from dashboard,
# REDIS_USERNAME=default, REDIS_PASSWORD=...
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# ── JWT (secrets only — lifetimes hardcoded) ───────────────
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=another_long_random_string_min_32_chars

# ── Google OAuth ───────────────────────────────────────────
# Mobile (Android/iOS): platform client ID only — NO secret.
# Web: CLIENT_ID + CLIENT_SECRET + CALLBACK_URL.
# Backend accepts ID tokens issued for ANY of the IDs below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ── Job-board APIs ─────────────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
SERPAPI_KEY=
RAPIDAPI_KEY=
THEIRSTACK_API_KEY=

# ── Anthropic (AI matching + search intent) ────────────────
# Real keys start with `sk-ant-`. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# ── Cron toggle (per-env) ──────────────────────────────────
CRON_ENABLED=true

# ── Email (Gmail SMTP credentials only) ────────────────────
SMTP_USER=
SMTP_PASS=

# ── Razorpay subscriptions ─────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Test keys — only honoured for debug-build clients in non-prod envs.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=

# ── Cloudinary (file storage) ──────────────────────────────
# Dashboard → Account Details. api_secret is sensitive.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Firebase (FCM push + Auth ID-token verification) ───────
#   FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
