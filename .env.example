# Job Hunter — environment template
#
# Only the values the backend NEEDS BEFORE the AppConfig DB cache loads
# live here: process bootstrap (Node env, port, client URL), Mongo +
# Redis connection strings, JWT signing secrets, and the AES master key
# used to decrypt admin-managed AppConfig secrets.
#
# EVERYTHING ELSE is admin-managed at runtime from the admin panel:
#   • AI provider keys (Gemini, Claude, Groq)      → /ai page
#   • Job-board API keys (Adzuna, JSearch, …)      → /config page  (category: job-board)
#   • Payments (Razorpay live + test + webhooks)   → /config page  (category: payment)
#   • Cloudinary upload credentials                → /config page  (category: cloudinary)
#   • SMTP (Gmail relay)                           → /config page  (category: email)
#   • Firebase project id + service-account JSON   → /config page  (category: firebase)
#   • Cron master kill-switch                      → /config page  (category: cron)
#   • MSG91 (SMS / WhatsApp OTP)                   → /config page  (category: misc)
#   • Rate limits (window + max)                   → /config page  (category: misc)
#
# The admin /config page has a "Suggested keys" dropdown backed by
# src/services/config/configRegistry.ts — it lists every backend-aware
# key with the right category, secret flag, default value and a one-line
# description so you don't have to remember exact names.
#
# Legacy .env values for the admin-managed keys above are still respected
# as a fallback (getAppConfig() reads process.env on cache miss) — so a
# fresh deployment can bootstrap from a .env file before the admin panel
# is reachable. Once configured via the admin UI, the env values become
# dead weight and can be deleted.

# ── Server (bootstrap) ─────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ── MongoDB (must connect before reading AppConfig) ────────
# MONGODB_URI is the test/dev cluster — used whenever NODE_ENV is not
# 'production' (local dev, CI, staging). MONGODB_URI_PROD is the
# production cluster — used only when NODE_ENV=production. If
# MONGODB_URI_PROD is unset in production, the loader falls back to
# MONGODB_URI so existing deployments keep working.
MONGODB_URI=mongodb://localhost:27017/job_hunter_test
MONGODB_URI_PROD=

# ── Redis (queues + caches; needed before any request) ─────
# Local: REDIS_HOST=localhost  REDIS_PORT=6379  (no creds)
# Redis Cloud / Upstash: full host, port from dashboard,
# REDIS_USERNAME=default, REDIS_PASSWORD=...
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# ── JWT signing (must exist to mint tokens) ────────────────
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=another_long_random_string_min_32_chars

# ── At-rest encryption master key ──────────────────────────
# Required to decrypt admin-managed AppConfig secrets (Cloudinary
# creds, Razorpay keys, AI provider keys, …). Optional in dev so the
# backend still boots without it. Generate with: `openssl rand -hex 32`.
CRYPTO_MASTER_KEY=

# ── Firebase (path-based service account loader, optional) ─
# If you'd rather paste the service-account JSON directly into the
# admin /config page (key: FIREBASE_SERVICE_ACCOUNT_JSON), leave this
# blank. The path-based loader is kept as a dev convenience.
#FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
