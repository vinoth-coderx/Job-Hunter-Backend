# ==============================================
# SERVER CONFIG
# ==============================================
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:3000

# ==============================================
# DATABASE - MongoDB
# ==============================================
MONGODB_URI=mongodb://localhost:27017/job_hunter
MONGODB_TEST_URI=mongodb://localhost:27017/job_hunter_test

# ==============================================
# REDIS
# Local: REDIS_HOST=localhost  REDIS_PORT=6379  (no username/password)
# Redis Cloud / Upstash: use full host, port from dashboard, REDIS_USERNAME=default
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_JOB_CACHE_TTL=3600

# ==============================================
# JWT AUTH
# ==============================================
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=another_long_random_string_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ==============================================
# GOOGLE OAUTH
# Create at: https://console.cloud.google.com/apis/credentials
# Mobile (Android/iOS): only need the platform client ID — NO secret.
# Web: need CLIENT_ID + CLIENT_SECRET + CALLBACK_URL.
# Backend accepts ID tokens issued for ANY of the IDs below.
# ==============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ==============================================
# JOB SCRAPING APIs
# ==============================================

# Adzuna - https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# SerpApi - https://serpapi.com/
SERPAPI_KEY=

# RapidAPI - https://rapidapi.com/
RAPIDAPI_KEY=
RAPIDAPI_JSEARCH_HOST=jsearch.p.rapidapi.com
RAPIDAPI_LINKEDIN_HOST=linkedin-data-api.p.rapidapi.com

# ==============================================
# AI - Anthropic Claude (for profile matching)
# ==============================================
ANTHROPIC_API_KEY=
AI_MATCH_THRESHOLD=50

# ==============================================
# CRON CONFIG
# ==============================================
CRON_JOB_FETCH_SCHEDULE=0 * * * *
CRON_CACHE_WARM_SCHEDULE=0 */6 * * *
CRON_ENABLED=true
JOB_FRESHNESS_DAYS=10

# ==============================================
# EMAIL (for verification & notifications)
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Job Hunter <noreply@jobhunter.com>

# ==============================================
# SUBSCRIPTION (Stripe / Razorpay - optional)
# ==============================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Generated in the Razorpay dashboard under Settings → Webhooks. Used to
# verify the HMAC of POST /api/v1/subscriptions/razorpay/webhook calls.
RAZORPAY_WEBHOOK_SECRET=

# ==============================================
# WHATSAPP (MSG91)
# Set all three to enable WhatsApp job alerts. Otherwise the cron just
# skips the WhatsApp step.
# ==============================================
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=
MSG91_WHATSAPP_TEMPLATE=
MSG91_WHATSAPP_NAMESPACE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
